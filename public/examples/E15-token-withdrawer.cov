-- E15: Treasury that moves an existing token (V0.9 composition pattern)
--
-- A file holds one construct, so the token and the module that spends it are
-- two separate deployments. That is the composition: deploy the token, then
-- deploy this module and point it at the token's address. The `external
-- contract` declaration is how the module knows the shape of what it calls.

external contract IGameToken {
    function transfer(address, amount) returns bool
    function balanceOf(address) view returns amount
}

module Treasury {
    field token_addr: address
    field admin: address

    action initialize(t: address, who: address) only deployer {
        token_addr = t
        admin = who
    }

    action distribute(recipient: address, value: amount) only admin {
        IGameToken.at(token_addr).transfer(recipient, value)
    }

    view treasury_balance(who: address) returns amount {
        IGameToken.at(token_addr).balanceOf(who)
    }
}
