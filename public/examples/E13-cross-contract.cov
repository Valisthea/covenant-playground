-- E13: Cross-Contract Calls (V0.9)
--
-- `external contract` declares the surface of a contract that already exists
-- on chain. The compiler checks every call site against that declaration and
-- emits a single properly encoded CALL with the right selector. Reach it with
-- `IName.at(address).method(args)`.

external contract IERC20 {
    function transfer(address, amount) returns bool
    function balanceOf(address) view returns amount
}

module Withdrawer {
    field token_addr: address
    field admin: address

    action initialize(t: address, who: address) only deployer {
        token_addr = t
        admin = who
    }

    action withdraw(value: amount) only admin {
        IERC20.at(token_addr).transfer(caller, value)
    }

    view token_balance(who: address) returns amount {
        IERC20.at(token_addr).balanceOf(who)
    }
}
